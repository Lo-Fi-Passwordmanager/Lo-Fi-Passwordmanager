{
  "manifest_version": 2,
  "name": "Lo-Fi Autofill",
  "version": "0.0.0",

  "description": "Provides password autofill from Lo-Fi Passwordmanager Databases.",

  "icons": {
    "16": "icons/logo_gelb.svg",
    "32": "icons/logo_gelb.svg",
    "48": "icons/logo_gelb.svg",
    "64": "icons/logo_gelb.svg",
    "128": "icons/logo_gelb.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "beastify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["borderify.js"]
    }
  ]
}