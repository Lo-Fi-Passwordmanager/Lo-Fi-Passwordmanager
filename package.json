{
  "name": "Lo-Fi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lo-fi-passwordmanager.github.io/Lo-Fi-Passwordmanager/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite --config vite.config.deploy.ts build",
    "lint": "eslint --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "playwright": "playwright test",
    "playwright:coverage": "cross-env COVERAGE=true E2E=true nyc playwright test --project=chromium",
    "playwright:report": "nyc report --reporter=html --report-dir playwright-coverage",
    "playwright:table": "nyc report --reporter=json-summary",
    "integration": "cross-env INTEGRATION=true vitest run",
    "integration:coverage": "cross-env INTEGRATION=true vitest run --coverage",
    "predeploy": "yarn run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.2",
    "@automerge/automerge-repo": "^2.5.1",
    "@automerge/react": "^2.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "hdd": "^0.0.0",
    "jsdom": "^29.0.2",
    "peerjs": "^1.5.5",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.5.0",
    "react-idle-timer": "^5.7.2",
    "rollup": "^4.44.1",
    "vite-plugin-wasm": "^3.3.0"
  },
  "devDependencies": {
    "@automerge/automerge-repo-react-hooks": "^2.5.1",
    "@emnapi/core": "^1.7.1",
    "@emnapi/runtime": "^1.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "4.1.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "nyc": "^18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vite-plugin-istanbul": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.4",
    "vitest-indexeddb": "^0.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
