    "@noble/hashes": "^2.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "automerge-repo-network-peerjs": "^1.2.3",
    "hdd": "^0.0.0",
    "jsdom": "^27.4.0",
    "peerjs": "^1.5.5",
    "qr-scanner": "^1.4.2",
