  "version": "0.1.0-beta",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite --config vite.config.deploy.ts build",
    "lint": "eslint --max-warnings 0",
