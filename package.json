    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:coverage": "cross-env COVERAGE=true E2E=true nyc playwright test --project=chromium; nyc report --reporter=html --report-dir playwright-coverage"
  },
